# EmailJS (https://www.emailjs.com) — copy to .env.local and fill in.
# Public key is safe in the browser; still keep .env.local out of git (*.local is ignored).

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional — where template should deliver (default: kareemkhamis2030@gmail.com)
# VITE_EMAILJS_TO_EMAIL=kareemkhamis2030@gmail.com
